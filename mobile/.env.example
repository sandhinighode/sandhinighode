# Copy this file to `.env` (same folder) and fill in the two values from your Supabase project:
# Supabase dashboard → Project Settings → API (or "Connect" button at the top).
#
# The key is the *publishable* key (starts with sb_publishable_) or the legacy *anon public* key.
# It is safe to put in the app: the database rules decide what it can read.
# NEVER put the secret / service_role key here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
